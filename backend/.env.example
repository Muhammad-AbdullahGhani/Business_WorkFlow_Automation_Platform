# SmartFlow AI Backend Environment Configuration

# Database: Default SQLite for instant local execution. Set to Postgres for production (e.g. Supabase, Neon, Docker)
DATABASE_URL=sqlite:///./smartflow.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartflow

# AI LLM Provider: "auto", "groq", "openai", "gemini", "local", or "fallback"
LLM_PROVIDER=auto

# Optional: Groq API Key (Free, fast Llama-3.3-70b at https://console.groq.com)
GROQ_API_KEY=

# Optional: OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=

# Optional: Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=

# Local Ollama settings (when LLM_PROVIDER=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Allowed CORS Origins (comma-separated or *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
